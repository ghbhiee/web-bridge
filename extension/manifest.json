{
  "manifest_version": 3,
  "name": "Web Bridge",
  "version": "0.1.0",
  "description": "Drive logged-in browser pages from local agents: run JS in a page's MAIN world or call site adapters, over an authenticated local bridge. MV3, generic, site-agnostic.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/relay.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Web Bridge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}